# Local-model tier env — fleet-router edition. Source before grid launches:
#   source test_framework/longrun/local_model.env
# Single source of truth for the local endpoint. Gate probe (must be GREEN):
#   bash test_framework/longrun/probe_local_model.sh
# Fleet guide: http://192.168.3.26:8000/guide  (LAN 192.168.3.0/24 only)
#
# Catalog snapshot 2026-11-20 (router, 5 models; per-model concurrency = 1):
#   qwen3-coder-30b     code tasks (non-thinking) — DEFAULT per guide
#   qwopus38-flash-v2   agentic efficiency (thinking)
#   qwen36-35b-mtp      general/128K (thinking)
#   olmocr-2 / qwen3-embed-0.6b  — excluded (no tools / embeddings only)
# Re-pin the whole tier by editing LOCAL_MODEL_ID (driver configs register
# all three; per-guide routing says pick by task type).

export LOCAL_MODEL_BASE="http://192.168.3.26:8000/v1"
export LOCAL_MODEL_ID="qwen3-coder-30b"

# aider (+ any OpenAI-compatible CLI): router ignores auth on LAN; key "none"
# per guide.
export OPENAI_API_KEY="none"
export OPENAI_API_BASE="$LOCAL_MODEL_BASE"

# codex: still blocked on this host (needs responses wire API; chat removed
# upstream Feb-2026) — kept for the day a responses-proxy lands.
export LONGRUN_CODEX_MODEL="$LOCAL_MODEL_ID"

# aider: openai/ prefix + OPENAI_API_BASE routes litellm at the router; the
# bare suffix is the router's model id (metadata: aider_model_metadata.json).
export LONGRUN_AIDER_MODEL="openai/$LOCAL_MODEL_ID"

# The router routes BY the model field — prefixed names 404. Grid pin serves
# kimi-code (bare alias) and reasonix (provider/model form) via the prefixed
# twins in their configs; hermes and aider get bare ids through their own
# override vars below.
export LONGRUN_MODEL="local/$LOCAL_MODEL_ID"

# kimi-code / reasonix: endpoints live in their config.toml (updated
# 2026-11-20 to this router); env vars kept for parity with the old tier env.
export KIMI_BASE_URL="$LOCAL_MODEL_BASE"
export KIMI_API_KEY="none"
export DEEPSEEK_BASE_URL="$LOCAL_MODEL_BASE"
export DEEPSEEK_API_KEY="none"

# hermes: harness routes run_agent at the router via HERMES_BASE_URL
# (harness extension 2026-11-15). Router rejects prefixed names →
# LONGRUN_HERMES_MODEL carries the bare id.
export HERMES_BASE_URL="$LOCAL_MODEL_BASE"
export HERMES_API_KEY="none"
export LONGRUN_HERMES_MODEL="$LOCAL_MODEL_ID"
