# Local-model tier env — source before ranked-driver bring-up / grid launches.
#   source test_framework/longrun/local_model.env
# Single source of truth for the Strix Halo baseline endpoint. Gate probe:
#   bash test_framework/longrun/probe_local_model.sh   (must be GREEN)
# Snapshot 2026-11-14: qwen36-35b-mtp, Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf, 128K ctx.

export LOCAL_MODEL_BASE="http://localhost:8080/v1"
export LOCAL_MODEL_ID="qwen36-35b-mtp"

# aider (+ any OpenAI-compatible CLI): dummy key — llama.cpp ignores auth
# unless started with --api-key.
export OPENAI_API_KEY="sk-local"
export OPENAI_API_BASE="$LOCAL_MODEL_BASE"

# codex: provider lives in ~/.codex/config.toml (wire_api="chat"); model via
#   LONGRUN_CODEX_MODEL="$LOCAL_MODEL_ID"
export LONGRUN_CODEX_MODEL="$LOCAL_MODEL_ID"

# aider: openai/ prefix + OPENAI_API_BASE routes to the local server
export LONGRUN_AIDER_MODEL="openai/$LOCAL_MODEL_ID"

# reasonix: config at ~/.config/reasonix/config.toml (env vars NOT read for
# keys — values live in ~/.reasonix/.env). Model needs the provider prefix.
# kimi-code: config at ~/.kimi-code/config.toml (same doctrine — no shell env).
export KIMI_BASE_URL="$LOCAL_MODEL_BASE"
export KIMI_API_KEY="sk-local"
export DEEPSEEK_BASE_URL="$LOCAL_MODEL_BASE"
export DEEPSEEK_API_KEY="sk-local"

# hermes: harness routes run_agent at the local server via HERMES_BASE_URL
# (harness extension 2026-11-15 — run_agent.main has base_url but no flag).
export HERMES_BASE_URL="$LOCAL_MODEL_BASE"
export HERMES_API_KEY="sk-local"
