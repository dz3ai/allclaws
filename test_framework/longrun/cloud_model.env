# Cloud-model tier env — source before glm-5.3 grid launches.
#   source test_framework/longrun/cloud_model.env
# The key is pulled from opencode's credential store AT SOURCE TIME — no
# secret is persisted in this repo. (Verified live 2026-11-17: coding-plan
# key serves both /api/coding/paas/v4 and /api/paas/v4.)

export CLOUD_MODEL_BASE="https://open.bigmodel.cn/api/coding/paas/v4"
export CLOUD_MODEL_ID="glm-5.3"

export ZHIPU_API_KEY="$(/usr/bin/python3 -c "
import sqlite3, json
db = sqlite3.connect('$HOME/.local/share/opencode/opencode.db')
row = db.execute(\"SELECT value FROM credential WHERE integration_id='zhipuai-coding-plan'\").fetchone()
print(json.loads(row[0])['key'])
")"

# aider (openai/ prefix + OPENAI_API_BASE) and hermes (harness env)
export OPENAI_API_KEY="$ZHIPU_API_KEY"
export OPENAI_API_BASE="$CLOUD_MODEL_BASE"
export LONGRUN_AIDER_MODEL="openai/$CLOUD_MODEL_ID"
export HERMES_BASE_URL="$CLOUD_MODEL_BASE"
export HERMES_API_KEY="$ZHIPU_API_KEY"

# kimi-code: provider 'cloud' in ~/.kimi-code/config.toml reads
# api_key_env=ZHIPU_API_KEY at request time (kimi DOES read explicitly-named
# env vars — just not conventional key names implicitly).
export KIMI_BASE_URL="$CLOUD_MODEL_BASE"
export KIMI_API_KEY="$ZHIPU_API_KEY"

# reasonix: provider 'cloud' in ~/.reasonix/config.toml (the ACTIVE config —
# ~/.config/reasonix/config.toml is only a migration source!); key value in
# ~/.reasonix/.env. Model id for grids: LONGRUN_MODEL=cloud/glm-5.3.
# hermes: strict endpoints reject prefixed names → own override var
export LONGRUN_HERMES_MODEL="$CLOUD_MODEL_ID"
