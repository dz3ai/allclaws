 import itertools
+from dataclasses import dataclass, field
+
+from .compat import record_as_dict
 
 _ids = itertools.count(1)
 
 REQUIRED_INVOICE_KEYS = ("id", "customer", "lines", "tax_rate_pct", "currency", "status")
 
 
+def _next_line_id():
+    return next(_ids)
+
+
+def _next_invoice_id():
+    return f"INV-{next(_ids):06d}"
+
+
+@dataclass
+class Line:
+    """One invoice line. Same fields as the legacy dict form."""
+
+    description: str
+    quantity: float
+    unit_price: float
+    discount_pct: float = 0.0
+    id: int = field(default_factory=_next_line_id)
+
+    def to_dict(self) -> dict:
+        return {
+            "id": self.id,
+            "description": self.description,
+            "quantity": self.quantity,
+            "unit_price": self.unit_price,
+            "discount_pct": self.discount_pct,
+        }
+
+
+@dataclass
+class Invoice:
+    """One invoice record, dict-compatible via get()/__getitem__/to_dict()."""
+
+    customer: str
+    lines: list = field(default_factory=list)
+    tax_rate_pct: float = 0.0
+    currency: str = "USD"
+    status: str = "draft"
+    id: str = field(default_factory=_next_invoice_id)
+
+    def to_dict(self) -> dict:
+        return {
+            "id": self.id,
+            "customer": self.customer,
+            "lines": [record_as_dict(line) for line in self.lines],
+            "tax_rate_pct": self.tax_rate_pct,
+            "currency": self.currency,
+            "status": self.status,
+        }
+
+    def get(self, key, default=None):
+        """Dict-style access so legacy callers keep working."""
+        return getattr(self, key, default)
+
+    def __getitem__(self, key):
+        try:
+            return getattr(self, key)
+        except AttributeError as e:
+            raise KeyError(key) from e
+
+
