     return dict(task)
 
 
+# ------------------------------------------------------------- comments
+
+MAX_AUTHOR_LEN = 80
+MAX_BODY_LEN = 2000
+
+
+def _validate_comment_fields(author, body):
+    if not isinstance(author, str) or not author.strip() or len(author) > MAX_AUTHOR_LEN:
+        raise ValidationError("author must be a non-empty string of at most 80 chars")
+    if not isinstance(body, str) or not 1 <= len(body) <= MAX_BODY_LEN:
+        raise ValidationError(f"body must be 1-{MAX_BODY_LEN} chars")
+
+
+def add_comment(task_id, author, body):
+    """Create a comment on a task; returns the comment dict."""
+    if task_id not in _tasks:
+        raise TaskNotFound(task_id)
+    _validate_comment_fields(author, body)
+    comment_id = f"c-{next(_comment_ids):06d}"
+    comment = {
+        "id": comment_id,
+        "task_id": task_id,
+        "author": author,
+        "body": body,
+        "created_at": _utcnow_iso(),
+    }
+    _comments.setdefault(task_id, []).append(comment)
+    return dict(comment)
+
+
+def list_comments(task_id):
+    """Comments on a task, ordered by created_at ascending."""
+    if task_id not in _tasks:
+        raise TaskNotFound(task_id)
+    clist = _comments.get(task_id, [])
+    return [dict(c) for c in sorted(clist, key=lambda c: (c["created_at"], c["id"]))]
+
+
+def delete_comment(task_id, comment_id):
+    """Remove one comment from a task."""
+    if task_id not in _tasks:
+        raise TaskNotFound(task_id)
+    clist = _comments.get(task_id, [])
+    for i, comment in enumerate(clist):
+        if comment["id"] == comment_id:
+            del clist[i]
+            return
+    raise CommentNotFound(comment_id)
+
+
